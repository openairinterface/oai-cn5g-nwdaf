FROM python:3.6.9-slim AS oai-nwdaf-engine-ads
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-color --upgrade "pip<22" "setuptools<60" "wheel<0.38" && \
    pip install --no-cache-dir -r requirements.txt --no-color && \
    pip cache purge
COPY . .
EXPOSE 8080/tcp
CMD [ "python3", "run.py" ]
